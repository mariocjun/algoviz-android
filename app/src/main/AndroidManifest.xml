<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET: needed by the 'Upload results' button to POST JSON to
         paste.rs and similar public paste services for remote analysis. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- ACCESS_NETWORK_STATE: lets the Gemini "Explicação IA" precheck detect
         offline BEFORE calling the model (the SDK wraps airplane-mode faults in
         its own exception type with a blank message, so reactive classification
         can't reliably tell offline from a generic API error). With this, the
         isOnline() check short-circuits to the "Sem conexão" state. See STD-1. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".AlgovizApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <!-- HomeActivity is the launcher: a Compose mini-app picker. It routes
             to each mini-app's dedicated Activity via explicit Intent. -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Profiler mini-app (CPU benchmarks, sensors, HW caps, paste.rs upload).
             Was the launcher in earlier versions; now reached via HomeActivity. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <!-- Native Compose sort visualizer. configChanges lets Compose handle
             rotation in place (its layout adapts portrait/landscape; no Activity
             recreate). -->
        <activity
            android:name=".VizActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout" />

        <!-- "Racha" — expense splitter / debt simplification mini-app. -->
        <activity
            android:name=".SplitwiseActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout" />

        <!-- "Extremo" / Min Cash Flow — full-screen animated debt-reduction. Also
             reachable from the Racha graph's ✨ chip. -->
        <activity
            android:name=".ExtremeActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout" />

        <!-- "Códex" — the project documentation / quality model, as a mini-app. -->
        <activity
            android:name=".DocsActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout" />
    </application>
</manifest>
