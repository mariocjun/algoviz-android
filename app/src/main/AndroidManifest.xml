<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- INTERNET: needed by the 'Upload results' button to POST JSON to
         paste.rs and similar public paste services for remote analysis. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".AlgovizApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <!-- HomeActivity is the launcher: a Compose mini-app picker. It routes
             to each mini-app's dedicated Activity via explicit Intent. -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Profiler mini-app (CPU benchmarks, sensors, HW caps, paste.rs upload).
             Was the launcher in earlier versions; now reached via HomeActivity. -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize" />

        <!-- Native Compose sort visualizer. configChanges lets Compose handle
             rotation in place (its layout adapts portrait/landscape; no Activity
             recreate). -->
        <activity
            android:name=".VizActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout" />

        <!-- Scheduler trainer mini-app (Maziero CPU/task scheduler reference). -->
        <activity
            android:name=".SchedActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout" />

        <!-- "Racha" — expense splitter / debt simplification mini-app. -->
        <activity
            android:name=".SplitwiseActivity"
            android:exported="false"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout" />
    </application>
</manifest>
