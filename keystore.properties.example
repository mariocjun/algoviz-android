# Copy to keystore.properties (gitignored) and fill in your RELEASE keystore.
#   cp keystore.properties.example keystore.properties
#
# These values AND the .jks file are SECRET — never commit them. BACK UP the
# .jks somewhere safe: if you lose the release keystore you can NEVER push another
# update to the same Play Store listing again. storeFile is resolved from the
# repo root.
storeFile=algoviz-release.jks
storePassword=CHANGE_ME
keyAlias=algoviz
keyPassword=CHANGE_ME
